{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "opencode": {
      "options": {
        "timeout": 1200000,
        "headerTimeout": 600000,
        "chunkTimeout": 600000,
        "setCacheKey": true
      }
    }
  },
  "plugins": [
    "opencode-timeout-continuer",
    "opencode-sticky-retry",
    "opencode-context-pruner",
    "@bandonker/opencode-context-pruner"
  ],
  "model": "opencode/big-pickle",
  "snapshot": false
}