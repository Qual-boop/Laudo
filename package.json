{
  "name": "relatorio-pentest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run --typecheck",
    "test:watch": "vitest --typecheck",
    "limpar-banco": "node scripts/limpar-banco.ts --executar",
    "stripe:setup": "node scripts/criar-produtos-stripe.ts",
    "stripe:webhook:start": "bash scripts/setup-webhook.sh",
    "stripe:webhook:stop": "bash scripts/parar-webhook.sh",
    "ambiente:iniciar": "bash scripts/iniciar-tudo.sh",
    "ambiente:parar": "bash scripts/parar-tudo.sh",
    "ambiente:status": "bash scripts/status-tudo.sh",
    "e2e": "bash scripts/e2e-completo.sh",
    "e2e:checkout": "bash scripts/e2e-completo.sh --apenas=checkout",
    "e2e:auth": "bash scripts/e2e-completo.sh --apenas=auth",
    "servicos:instalar": "bash scripts/instalar-servicos.sh",
    "servicos:status": "sudo systemctl status stripe-listen",
    "servicos:logs": "sudo tail -f /var/log/stripe-listen.log",
    "servicos:parar": "sudo systemctl stop stripe-listen",
    "servicos:reiniciar": "sudo systemctl restart stripe-listen"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "next": "16.4.0",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
