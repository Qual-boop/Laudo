# Chave da API do provedor de IA (compatível com a API da OpenAI).
# Sem esta variável o app monta o relatório localmente, sem enriquecimento por IA.
# Gemini (Google AI Studio): https://aistudio.google.com/apikey
OPENAI_API_KEY=

# Endpoint do provedor.
# Gemini:  https://generativelanguage.googleapis.com/v1beta/openai/
# OpenAI:  https://api.openai.com/v1
# Groq:    https://api.groq.com/openai/v1
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Modelo usado para gerar o relatório.
LAUDO_MODELO=gemini-3.8-flash

# Limite de tokens da resposta. Relatórios completos precisam de folga.
LAUDO_MAX_TOKENS=16000
