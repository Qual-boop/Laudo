# ============================================================
# Cadeia de provedores de IA
#
# O Provafix tenta os provedores na ordem em que aparecem abaixo e
# para no primeiro que responder. Se todos falharem, monta o
# relatório localmente (sem IA). Provedor sem chave configurada
# é simplesmente ignorado.
#
#   1. Gemini  (principal)   — OPENAI_API_KEY
#   2. Groq    (secundário)  — GROQ_API_KEY
#   3. Relatório local       — sem rede
# ============================================================

# ---------- Nível 1: Gemini ----------
# Chave em https://aistudio.google.com/apikey
OPENAI_API_KEY=

# Endpoint. Gemini usa a camada compatível com a API da OpenAI.
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Modelo e limite de tokens do Gemini.
LAUDO_MODELO=gemini-3.8-flash
LAUDO_MAX_TOKENS=16000

# ---------- Nível 2: Groq ----------
# Chave em https://console.groq.com/keys
# Sem esta chave o Provafix funciona só com o Gemini — mas o Gemini
# costuma devolver 503 na cota gratuita, então ter o Groq como
# segundo nível evita cair no relatório local na maioria das vezes.
GROQ_API_KEY=

# Opcional: sobrescreve https://api.groq.com/openai/v1
GROQ_BASE_URL=
GROQ_MODELO=openai/gpt-oss-120b
GROQ_MAX_TOKENS=6000

# ---------- Ajustes ----------
# Espera base (ms) do backoff exponencial entre retentativas.
# Padrão: 2000 (2s → 4s → 8s).
LAUDO_RETRY_BASE_MS=

# ---------- Auth (NextAuth v5, sessão JWT) ----------
# Segredo do JWT. Gere com: openssl rand -base64 32
# Obrigatório em produção — sem ele, login e /api/v1/* retornam erro.
AUTH_SECRET=

# Google OAuth (opcional). Sem estas duas, o botão "entrar com Google"
# nem aparece — o login com e-mail + senha funciona normalmente.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Em produção atrás de proxy, defina o domínio canônico:
# AUTH_URL=https://seu-dominio.com
# AUTH_TRUST_HOST=true

# ---------- Billing (Asaas — sandbox primeiro) ----------
# Chave em https://sandbox.asaas.com (Conta > Integrações > Chave API).
ASAAS_API_KEY=
# Base: sandbox para teste; produção: https://api.asaas.com/v3
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Token do webhook (painel Asaas > Integrações > Webhook). Opcional em dev:
# sem ele, /api/v1/webhook/asaas aceita chamadas locais (simulação).
ASAAS_WEBHOOK_TOKEN=
# Token da validação de saque via webhook (Mecanismos de segurança).
# A rota recusa todo saque de qualquer jeito; o token só marca no log
# que a tentativa veio do Asaas (= chave vazada).
ASAAS_SAQUE_TOKEN=

# ---------- Banco (Neon/Postgres em produção, SQLite local) ----------
# Local/testes: sem DATABASE_URL o app usa pentest.db (better-sqlite3).
# Produção (Vercel + Neon): crie o banco em https://neon.tech e cole aqui:
# DATABASE_URL=postgresql://usuario:senha@ep-xxx.us-east-2.aws.neon.tech/laudo?sslmode=require
DATABASE_URL=
# Rode uma vez para copiar os dados locais: npm run migrar-dados -- --executar
# (dry-run sem --executar). Ver scripts/migrar-dados.ts e docs/DEPLOY.md.

# ---------- E-mail (login em 2 etapas e "esqueci minha senha") ----------
# API HTTPS (o Railway bloqueia SMTP fora do plano Pro). Use UMA das chaves:
#   Brevo  (brevo.com, grátis 300/dia; remetente verificado basta, sem domínio)
#   Resend (resend.com, grátis 3.000/mês; exige domínio próprio verificado)
# Sem chave ou sem EMAIL_REMETENTE: login só com senha e sem recuperação.
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_REMETENTE=
EMAIL_REMETENTE_NOME=Provafix

# ---------- App (URLs públicas p/ redirects do checkout Asaas) ----------
# Produção: https://provafix.up.railway.app (ou seu domínio). Usado para montar
# successUrl/cancelUrl/expiredUrl do checkout Asaas.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dev: caminho do SQLite fora da pasta do projeto evita o ciclo de
# recompilação do `next dev` a cada escrita no banco. Ex.: ~/.laudo/pentest.db
# SQLITE_PATH=
